# Shared secret your external agent sends as: Authorization: Bearer <key>
AGENT_API_KEY=replace-with-a-long-random-string

# Optional: school-day timezone for default focusDate (IANA name)
FOCUS_TIMEZONE=America/New_York

# Production persistence on Vercel (Upstash Redis — free tier works)
# Create via Vercel Marketplace → Upstash, or https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
